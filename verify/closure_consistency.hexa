#!hexa strict
// hexa-scope/verify/closure_consistency.hexa — scoreboard cross-check.
//
// Confirms three sources agree on the 2-verb + 7-mission scoreboard:
//   1. cli/hexa-scope.hexa MISSIONS table (registry of record)
//   2. hexa.toml [closure] verbs_total + mission_overviews
//   3. README.md badge "verbs-2_spec" + "missions-7_concept"
//
// Per LATTICE_POLICY §1.3 rule 4: this is *internal* self-consistency
// (own substrate's own scoreboard), NOT a claim about NASA / ESA / JAXA /
// CNSA / NSF program structure.

let HOME = env("HOME")
let HEXA_SCOPE_ROOT_ENV = env("HEXA_SCOPE_ROOT")

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _resolve_root() -> str {
    if HEXA_SCOPE_ROOT_ENV.len() > 0 { return HEXA_SCOPE_ROOT_ENV }
    let oldpwd = env("OLDPWD")
    if oldpwd.len() > 0 {
        let t = exec("[ -f " + shq(oldpwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return oldpwd }
    }
    let pwd = env("PWD")
    if pwd.len() > 0 {
        let t = exec("[ -f " + shq(pwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return pwd }
    }
    return HOME + "/core/hexa-scope"
}

fn _count_mission_rows(root: str) -> int {
    let cli = root + "/cli/hexa-scope.hexa"
    let cmd = "grep -E 'let MISSIONS = \\[' " + shq(cli) + " | head -1"
    let line = exec(cmd).trim()
    if line.len() == 0 { return -1 }
    // count quoted mission identifiers in the line
    let n_cmd = "grep -E 'let MISSIONS = \\[' " + shq(cli) + " | head -1 | grep -oE '\"[a-z]+\"' | wc -l"
    let raw = exec(n_cmd).trim()
    if raw.len() == 0 { return -1 }
    return int(raw)
}

fn _count_verb_dispatch(root: str) -> int {
    let cli = root + "/cli/hexa-scope.hexa"
    // count `if sub == "<verb>" { cmd_*(); return }` style lines for non-mission verbs.
    // We expect observatory + obs_astronomy = 2 (mission is its own dispatcher).
    let cmd = "grep -cE '^    if sub == \"(observatory|obs_astronomy)\"' " + shq(cli)
    let raw = exec(cmd).trim()
    if raw.len() == 0 { return -1 }
    return int(raw)
}

fn _toml_int(root: str, key: str) -> int {
    let toml = root + "/hexa.toml"
    let cmd = "awk -F'=' '/^" + key + " *=/ {gsub(/[^0-9]/,\"\",$2); print $2; exit}' " + shq(toml)
    let raw = exec(cmd).trim()
    if raw.len() == 0 { return -1 }
    return int(raw)
}

fn _readme_badge_int(root: str, pattern: str) -> int {
    let readme = root + "/README.md"
    let cmd = "grep -oE '" + pattern + "' " + shq(readme) + " | head -1 | grep -oE '[0-9]+'"
    let raw = exec(cmd).trim()
    if raw.len() == 0 { return -1 }
    return int(raw)
}

fn _file_contains(p: str, needle: str) -> bool {
    let cmd = "grep -F " + shq(needle) + " " + shq(p) + " >/dev/null 2>&1 && echo yes || echo no"
    return exec(cmd).trim() == "yes"
}

fn main() {
    let root = _resolve_root()
    println("hexa-scope/verify/closure_consistency — scoreboard cross-check")
    println("  root: " + root)
    println("")

    let mut ok = 0
    let mut bad = 0

    let cli_verbs = _count_verb_dispatch(root)
    let cli_missions = _count_mission_rows(root)
    let toml_verbs_total = _toml_int(root, "verbs_total")
    let toml_missions = _toml_int(root, "mission_overviews")
    let readme_verbs = _readme_badge_int(root, "verbs-[0-9]+_spec")
    let readme_missions = _readme_badge_int(root, "missions-[0-9]+_concept")

    println("  cli verb dispatch rows (observatory+obs_astronomy): " + str(cli_verbs))
    println("  cli MISSIONS array entries:                         " + str(cli_missions))
    println("  hexa.toml verbs_total:                              " + str(toml_verbs_total))
    println("  hexa.toml mission_overviews:                        " + str(toml_missions))
    println("  README badge verbs-N_spec:                          " + str(readme_verbs))
    println("  README badge missions-N_concept:                    " + str(readme_missions))
    println("")

    if cli_verbs == 2 {
        println("  [PASS] CLI registry has 2 verbs (observatory + obs_astronomy)")
        ok = ok + 1
    } else {
        println("  [FAIL] CLI registry has " + str(cli_verbs) + " verbs (expected 2)")
        bad = bad + 1
    }
    if cli_missions == 7 {
        println("  [PASS] CLI MISSIONS = 7 (hubble/jwst/lsst/roman/luvoir/origins/habex)")
        ok = ok + 1
    } else {
        println("  [FAIL] CLI MISSIONS = " + str(cli_missions) + " (expected 7)")
        bad = bad + 1
    }
    if toml_verbs_total == 2 {
        println("  [PASS] hexa.toml verbs_total = 2")
        ok = ok + 1
    } else {
        println("  [FAIL] hexa.toml verbs_total = " + str(toml_verbs_total))
        bad = bad + 1
    }
    if toml_missions == 7 {
        println("  [PASS] hexa.toml mission_overviews = 7")
        ok = ok + 1
    } else {
        println("  [FAIL] hexa.toml mission_overviews = " + str(toml_missions))
        bad = bad + 1
    }
    if readme_verbs == 2 {
        println("  [PASS] README badge verbs-2_spec")
        ok = ok + 1
    } else {
        println("  [FAIL] README badge verbs-" + str(readme_verbs) + "_spec (expected 2)")
        bad = bad + 1
    }
    if readme_missions == 7 {
        println("  [PASS] README badge missions-7_concept")
        ok = ok + 1
    } else {
        println("  [FAIL] README badge missions-" + str(readme_missions) + "_concept (expected 7)")
        bad = bad + 1
    }

    // Standard policy artifacts must be present.
    let must = ["LATTICE_POLICY.md", "LIMIT_BREAKTHROUGH.md", "AGENTS.md", "hexa.toml", "README.md", "LICENSE", "CITATION.cff"]
    for f in must {
        let abs_f = root + "/" + f
        let cmd = "[ -f " + shq(abs_f) + " ] && echo y || echo n"
        if exec(cmd).trim() == "y" {
            println("  [PASS] standard artifact: " + f)
            ok = ok + 1
        } else {
            println("  [FAIL] standard artifact missing: " + f)
            bad = bad + 1
        }
    }

    // AGENTS.md must register LATTICE_POLICY + LIMIT_BREAKTHROUGH.
    let agents = root + "/AGENTS.md"
    if _file_contains(agents, "LATTICE_POLICY.md") {
        println("  [PASS] AGENTS.md registers LATTICE_POLICY.md")
        ok = ok + 1
    } else {
        println("  [FAIL] AGENTS.md does not register LATTICE_POLICY.md")
        bad = bad + 1
    }
    if _file_contains(agents, "LIMIT_BREAKTHROUGH.md") {
        println("  [PASS] AGENTS.md registers LIMIT_BREAKTHROUGH.md")
        ok = ok + 1
    } else {
        println("  [FAIL] AGENTS.md does not register LIMIT_BREAKTHROUGH.md")
        bad = bad + 1
    }

    println("")
    println("  passed: " + str(ok) + "  failed: " + str(bad))
    if bad > 0 {
        println("__HEXA_SCOPE_CLOSURE_CONSISTENCY__ FAIL")
        exit(1)
    }
    println("__HEXA_SCOPE_CLOSURE_CONSISTENCY__ PASS")
}
