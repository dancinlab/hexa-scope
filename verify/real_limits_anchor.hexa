#!hexa strict
// hexa-scope/verify/real_limits_anchor.hexa — real-limits-first anchor.
//
// Per LATTICE_POLICY.md §1.3 rule 2: each project's verify must use at
// least one anchor from §1.2 + at least one engineering/industry threshold.
//
// hexa-scope's real-limits audit lives in LIMIT_BREAKTHROUGH.md (Wave M,
// 2026-05-12). This script confirms that file is present and references
// the canonical telescope-observation HARD walls (diffraction λ/D,
// photon-noise √N, c-bound on cosmic horizon, NA ≤ n, detector physics)
// + the published mission ICDs (HST 2.4 m, JWST 6.5 m / 18 hex, LSST
// 8.4 m, Roman 2.4 m, ELT 39 m, TMT 30 m, GMT 25 m) so any agent has a
// pointer from verify→audit.
//
// Honesty (raw#10 C3): every aperture number is sourced from the
// mission's own published ICD (NASA/ESA/CSA/CNSA/NSF). Future-mission
// apertures (LUVOIR-A 15 m, LUVOIR-B 8 m, Origins 5.9 m, HabEx 4 m) are
// **CONCEPT / funding-pending** per NASA Astro2020 study reports — they
// are NOT claims of flight hardware. Markers preserved here.

let HOME = env("HOME")
let HEXA_SCOPE_ROOT_ENV = env("HEXA_SCOPE_ROOT")

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _resolve_root() -> str {
    if HEXA_SCOPE_ROOT_ENV.len() > 0 { return HEXA_SCOPE_ROOT_ENV }
    let oldpwd = env("OLDPWD")
    if oldpwd.len() > 0 {
        let t = exec("[ -f " + shq(oldpwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return oldpwd }
    }
    let pwd = env("PWD")
    if pwd.len() > 0 {
        let t = exec("[ -f " + shq(pwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return pwd }
    }
    return HOME + "/core/hexa-scope"
}

fn _file_exists(p: str) -> bool {
    let r = exec("[ -f " + shq(p) + " ] && echo yes || echo no").trim()
    return r == "yes"
}

fn _file_contains(p: str, needle: str) -> bool {
    let cmd = "grep -F " + shq(needle) + " " + shq(p) + " >/dev/null 2>&1 && echo yes || echo no"
    let r = exec(cmd).trim()
    return r == "yes"
}

fn main() {
    let root = _resolve_root()
    println("hexa-scope/verify/real_limits_anchor — real-limits-first check")
    println("  root: " + root)
    println("")
    println("  policy: LATTICE_POLICY §1.3 rule 2 — at least 1 real limit anchor required")
    println("  source: LIMIT_BREAKTHROUGH.md (Wave M, telescope-substrate audit)")
    println("  policy: raw#10 C3 — NASA/ESA/JAXA/CNSA/NSF specs are their own ICDs")
    println("")

    let mut ok = 0
    let mut bad = 0

    // 1. Audit file must exist.
    let audit = root + "/LIMIT_BREAKTHROUGH.md"
    if _file_exists(audit) {
        println("  [PASS] LIMIT_BREAKTHROUGH.md present")
        ok = ok + 1
    } else {
        println("  [FAIL] LIMIT_BREAKTHROUGH.md missing (abs: " + audit + ")")
        bad = bad + 1
    }

    // 2. Audit must reference canonical telescope HARD walls + published mission specs.
    //    Each anchor is a sourced HARD/SOFT wall from LIMIT_BREAKTHROUGH.md §2.
    let anchors = [
        ["Diffraction θ = 1.22·λ/D (HARD)",     "1.22"],            // §2.1 classical diffraction
        ["Rayleigh/Abbe diffraction limit",      "diffraction limit"], // §2.1 phrasing
        ["HST 2.4 m primary (NASA ICD)",         "2.4 m"],           // §2.1 HST aperture
        ["JWST 6.5 m / 18 segments (NASA ICD)",  "6.5 m"],           // §2.1 JWST aperture
        ["LSST/Rubin 8.4 m (NSF ICD)",           "8.4 m"],           // §2.5 LSST aperture
        ["LUVOIR-A 15 m (concept)",              "15 m"],            // §2.1 future concept
        ["Photon Poisson SNR = √N (HARD)",       "Poisson"],         // §2.2 photon noise
        ["NA ≤ n geometric ceiling (HARD)",      "NA"],              // §2.4 numerical aperture
        ["Cosmic horizon / CMB last-scatter",    "CMB"],             // §2.6 cosmic limits
        ["c-bound on round-trip observation",    "round-trip"],      // §2.6 c-bound
        ["Atmospheric seeing 0.4–0.6 arcsec",    "seeing"],          // §2.7 atmosphere
    ]
    for a in anchors {
        let label = a[0]
        let needle = a[1]
        if _file_contains(audit, needle) {
            println("  [PASS] anchor referenced: " + label)
            ok = ok + 1
        } else {
            println("  [FAIL] anchor missing: " + label + " (needle: '" + needle + "')")
            bad = bad + 1
        }
    }

    // 3. Honesty caveats: future-mission concepts must remain marked as
    //    proposal / pre-mission (raw#10 C3 + LATTICE_POLICY §3.3).
    //    The substrate must not pretend LUVOIR/Origins/HabEx are flown.
    let unverified = [
        ["LUVOIR is proposal lineage",       "LUVOIR"],
        ["Post-Hubble proposals (Origins 5.9m, HabEx 4m) — concept lineage", "post-Hubble proposals"],
        ["Super-resolution does NOT break diffraction (honest framing)", "Super-resolution"],
    ]
    for u in unverified {
        let label = u[0]
        let needle = u[1]
        if _file_contains(audit, needle) {
            println("  [PASS] concept/honesty caveat preserved: " + label)
            ok = ok + 1
        } else {
            println("  [FAIL] concept/honesty caveat MISSING: " + label)
            bad = bad + 1
        }
    }

    // 4. AGENTS.md must register LATTICE_POLICY + LIMIT_BREAKTHROUGH.
    let agents = root + "/AGENTS.md"
    if _file_contains(agents, "LATTICE_POLICY.md") {
        println("  [PASS] AGENTS.md registers LATTICE_POLICY.md")
        ok = ok + 1
    } else {
        println("  [FAIL] AGENTS.md does not register LATTICE_POLICY.md")
        bad = bad + 1
    }
    if _file_contains(agents, "LIMIT_BREAKTHROUGH.md") {
        println("  [PASS] AGENTS.md registers LIMIT_BREAKTHROUGH.md")
        ok = ok + 1
    } else {
        println("  [FAIL] AGENTS.md does not register LIMIT_BREAKTHROUGH.md")
        bad = bad + 1
    }

    println("")
    println("  anchors verified: " + str(ok) + "  failures: " + str(bad))
    if bad > 0 {
        println("__HEXA_SCOPE_REAL_LIMITS_ANCHOR__ FAIL")
        exit(1)
    }
    println("__HEXA_SCOPE_REAL_LIMITS_ANCHOR__ PASS")
}
